{
  "name": "mediation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 6080",
    "dev:mp": "tsx server/mp/index.ts",
    "build": "nuxt build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "npx tsx server/database/migrate.ts",
    "db:seed": "npx tsx server/database/seed.ts",
    "db:seed-cases": "npx tsx server/database/seed-cases.ts",
    "kb": ".venv-kb/bin/python3 server/kb/server.py 8700",
    "dev:all": "bash scripts/dev-all.sh",
    "eval": "tsx server/eval/run.ts",
    "eval:baseline": "tsx server/eval/run.ts --baseline",
    "eval:compare": "tsx server/eval/run.ts --compare",
    "value:regenerate": "tsx server/eval/regenerate.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.41.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^3.17.2",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}