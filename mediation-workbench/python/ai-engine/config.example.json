{
  "agents": {
    "defaults": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek",
      "max_tokens": 4096,
      "temperature": 0.7,
      "timezone": "Asia/Shanghai",
      "workspace": ".data/ai/workspace"
    }
  },
  "providers": {
    "deepseek": {
      "api_key": "${DEEPSEEK_API_KEY}",
      "api_base": "https://api.deepseek.com/v1"
    }
  },
  "tools": {
    "web": { "enable": false },
    "exec": { "enable": false },
    "file": { "enable": false },
    "cli_apps": { "enable": false },
    "my": { "enable": false, "allow_set": false },
    "image_generation": { "enabled": false }
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8900,
    "timeout": 120.0,
    "api_key": ""
  }
}
