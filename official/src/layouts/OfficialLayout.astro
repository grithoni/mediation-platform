<script is:inline>
  function getTheme() {
    try { return localStorage.getItem('zhujiang-theme') } catch(e) { return null }
  }
  function setTheme(t) {
    try { localStorage.setItem('zhujiang-theme', t) } catch(e) {}
  }

  function applyTheme(theme) {
    var darkIcon = document.getElementById('themeIconDark')
    var lightIcon = document.getElementById('themeIconLight')
    if (theme === 'dark') {
      document.documentElement.classList.add('dark')
      if (darkIcon) darkIcon.classList.remove('hidden')
      if (lightIcon) lightIcon.classList.add('hidden')
    } else {
      document.documentElement.classList.remove('dark')
      if (darkIcon) darkIcon.classList.add('hidden')
      if (lightIcon) lightIcon.classList.remove('hidden')
    }
  }

  var saved = getTheme()
  if (saved) {
    applyTheme(saved)
  } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
    applyTheme('dark')
  }

  window.toggleTheme = function() {
    var isDark = document.documentElement.classList.contains('dark')
    var next = isDark ? 'light' : 'dark'
    applyTheme(next)
    setTheme(next)
  }

  window.toggleDropdown = function(e) {
    e.stopPropagation()
    var btn = e.currentTarget
    var container = btn.closest('[data-dropdown]')
    var panel = container.querySelector('[data-dropdown-panel]')
    var arrow = container.querySelector('[data-dropdown-arrow]')
    var isOpen = !panel.classList.contains('hidden')

    document.querySelectorAll('[data-dropdown-panel]').forEach(function(p) { p.classList.add('hidden') })
    document.querySelectorAll('[data-dropdown-arrow]').forEach(function(a) { a.style.transform = '' })

    if (!isOpen) {
      panel.classList.remove('hidden')
      arrow.style.transform = 'rotate(180deg)'
    }
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('[data-dropdown]')) {
      document.querySelectorAll('[data-dropdown-panel]').forEach(function(p) { p.classList.add('hidden') })
      document.querySelectorAll('[data-dropdown-arrow]').forEach(function(a) { a.style.transform = '' })
    }
  })

  window.toggleMobileMenu = function() {
    var overlay = document.getElementById('mobileOverlay')
    var drawer = document.getElementById('mobileDrawer')
    var openIcon = document.getElementById('mobileMenuOpen')
    var closeIcon = document.getElementById('mobileMenuClose')
    var isOpen = !drawer.classList.contains('-translate-x-full')

    if (isOpen) {
      drawer.classList.add('-translate-x-full')
      overlay.classList.add('hidden')
      if (openIcon) openIcon.classList.remove('hidden')
      if (closeIcon) closeIcon.classList.add('hidden')
    } else {
      drawer.classList.remove('-translate-x-full')
      overlay.classList.remove('hidden')
      if (openIcon) openIcon.classList.add('hidden')
      if (closeIcon) closeIcon.classList.remove('hidden')
    }
  }

  window.toggleMobileSub = function(label) {
    var sub = document.getElementById('mobileSub-' + label)
    var arrow = document.getElementById('mobileSubArrow-' + label)
    var isOpen = sub.classList.contains('max-h-40')

    if (isOpen) {
      sub.classList.remove('max-h-40', 'opacity-100')
      sub.classList.add('max-h-0', 'opacity-0')
      arrow.style.transform = ''
    } else {
      sub.classList.remove('max-h-0', 'opacity-0')
      sub.classList.add('max-h-40', 'opacity-100')
      arrow.style.transform = 'rotate(180deg)'
    }
  }
</script>
