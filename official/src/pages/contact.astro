---
import OfficialLayout from '../layouts/OfficialLayout.astro'
---

<OfficialLayout title="联系我们" description="珠江国际商事调解院联系方式">
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/hero-bg.jpg');" />
    <div class="absolute inset-0 bg-gradient-to-br from-blue-950/85 via-blue-900/75 to-gray-900/85" />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-xs text-white/80 mb-4">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span>Contact Us</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">联系我们</h1>
      <p class="mt-3 text-base sm:text-lg text-blue-200 max-w-2xl mx-auto">Contact Us</p>
    </div>
  </section>

  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-8">联系方式</h2>

          <div class="space-y-6">
            <!-- Address -->
            <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6 flex items-start gap-4">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">办公地址</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">广州市越秀区沿江中路298号</p>
                <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">江湾商业中心中区14楼</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6 flex items-start gap-4">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">联系电话</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">020-83288530</p>
              </div>
            </div>

            <!-- Email -->
            <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6 flex items-start gap-4">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">电子邮箱</h3>
                <p class="text-sm text-blue-600 dark:text-blue-400">contact@zjmediation.org</p>
              </div>
            </div>

            <!-- Hours -->
            <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6 flex items-start gap-4">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">工作时间</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">工作日 9:00 - 18:00</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">周末及法定节假日除外</p>
              </div>
            </div>
          </div>

          <!-- Transport Guide -->
          <div class="mt-10">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">交通指引</h2>
            <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
              <div class="space-y-4 text-sm text-gray-500 dark:text-gray-400">
                <div>
                  <h3 class="font-semibold text-gray-700 dark:text-gray-300 mb-1">地铁</h3>
                  <p>6号线团一大广场站B出口，步行约5分钟</p>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-700 dark:text-gray-300 mb-1">公交</h3>
                  <p>可乘坐4路、57路、128路、131B路、208路至"东堤站"或"沿江中站"下车</p>
                </div>
                <div>
                  <h3 class="font-semibold text-gray-700 dark:text-gray-300 mb-1">自驾</h3>
                  <p>导航至"江湾商业中心"，大厦设有地下停车场</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Links & Inquiry -->
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-8">快速通道</h2>

          <div class="space-y-4 mb-10">
            <a href="/mediation" class="block bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/50 rounded-xl p-5 hover:shadow-md transition-all duration-200 group">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 19.5v.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8.5L18 5.5"/><circle cx="8" cy="13" r="2"/><path d="M14 19c0-3.5 3-5 5-5"/><path d="M14 13c0-2.5 2-4 4-4"/></svg>
                </div>
                <div>
                  <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">在线调解申请</h3>
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">通过在线平台提交调解申请</p>
                </div>
              </div>
            </a>

            <a href="/mediation/guide" class="block bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/50 rounded-xl p-5 hover:shadow-md transition-all duration-200 group">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <div>
                  <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">流程指引</h3>
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">了解完整的调解流程与步骤</p>
                </div>
              </div>
            </a>

            <a href="/about" class="block bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/50 rounded-xl p-5 hover:shadow-md transition-all duration-200 group">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                </div>
                <div>
                  <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">关于我们</h3>
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">了解更多机构背景与资质</p>
                </div>
              </div>
            </a>
          </div>

          <!-- Business Info -->
          <div class="bg-gray-50 dark:bg-gray-900/50 rounded-xl p-6">
            <h3 class="text-base font-bold text-gray-900 dark:text-white mb-4">业务咨询</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
              如果您需要了解更多关于我们的服务信息，或有任何业务合作意向，欢迎通过以下方式联系我们。
            </p>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
              我们的工作人员将在收到咨询后的1个工作日内与您联系。紧急事项请直接来电沟通。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</OfficialLayout>
