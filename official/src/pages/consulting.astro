---
import OfficialLayout from '../layouts/OfficialLayout.astro'
---

<OfficialLayout title="咨询服务" description="珠江国际商事调解院 - 争议解决策略咨询">
  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/hero-bg.jpg');" />
    <div class="absolute inset-0 bg-gradient-to-br from-amber-950/85 via-amber-900/75 to-gray-900/85" />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-xs text-white/80 mb-4">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <span>Consulting Services</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">咨询服务</h1>
      <p class="mt-3 text-base sm:text-lg text-amber-200 max-w-2xl mx-auto">Consulting Services</p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Overview -->
      <div class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-6">服务概述</h2>
        <div class="space-y-4 text-gray-600 dark:text-gray-400 leading-relaxed text-base">
          <p>
            珠江国际商事调解院为企业、政府机构和行业组织提供全方位的争议解决策略咨询服务。
            依托我们在商事调解、仲裁、诉讼等领域的深厚积累，帮助客户构建完善的争议预防与管理体系，
            降低法律风险，优化商业决策。
          </p>
          <p>
            我们的咨询团队由<strong class="text-gray-900 dark:text-white">资深法律专家、行业顾问和前法官</strong>组成，
            能够从法律、商业和管理多个维度为客户提供切实可行的解决方案。
          </p>
        </div>
      </div>

      <!-- Services -->
      <div class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-6">咨询服务范围</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">争议解决策略制定</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">根据客户具体情况，分析评估各类争议解决路径（协商、调解、仲裁、诉讼）的优劣，制定最优策略方案。</p>
          </div>
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">风险评估与预警</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">对企业合同、经营行为进行全面法律风险评估，识别潜在争议风险点并提供预警和防范建议。</p>
          </div>
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">纠纷预防体系建设</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">协助企业建立内部争议预防与早期解决机制，包括合同审批流程优化、争议预警机制和多元化解纷渠道设计。</p>
          </div>
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="M3 8l4-4 4 4"/><path d="M7 4v16"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">跨境争议管理</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">为涉及跨境业务的客户提供国际商事争议管理咨询，包括法律适用分析、管辖权选择和跨境执行策略。</p>
          </div>
        </div>
      </div>

      <!-- Industry Focus -->
      <div class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-6">重点行业领域</h2>
        <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-8">
          <div class="grid sm:grid-cols-3 gap-4">
            <div class="text-center p-4">
              <div class="w-12 h-12 mx-auto rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="8" x2="12" y1="10" y2="10"/></svg>
              </div>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">国际贸易</h3>
            </div>
            <div class="text-center p-4">
              <div class="w-12 h-12 mx-auto rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7-5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg>
              </div>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">建设工程</h3>
            </div>
            <div class="text-center p-4">
              <div class="w-12 h-12 mx-auto rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              </div>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">金融投资</h3>
            </div>
            <div class="text-center p-4">
              <div class="w-12 h-12 mx-auto rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10"/><path d="M2 12h20"/></svg>
              </div>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">知识产权</h3>
            </div>
            <div class="text-center p-4">
              <div class="w-12 h-12 mx-auto rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
              </div>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">供应链</h3>
            </div>
            <div class="text-center p-4">
              <div class="w-12 h-12 mx-auto rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-3">
                <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M8 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/></svg>
              </div>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">科技与互联网</h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Choose -->
      <div class="mb-16">
        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 dark:text-white mb-6">为什么选择我们的咨询服务</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">深度行业洞察</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">深耕商事争议解决领域，积累丰富的行业数据和案例经验，能够提供精准的法律与商业分析。</p>
          </div>
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">多元专家团队</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">法律专家、行业顾问、前法官和资深调解员组成的跨专业团队，提供多维度、立体化的咨询服务。</p>
          </div>
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">一站式服务</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">从风险识别、策略制定到争议解决执行，提供全流程、闭环式的咨询服务。</p>
          </div>
          <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl p-6">
            <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">严格保密</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">所有咨询信息均受严格保密义务约束，保护客户商业秘密和经营信息。</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-amber-600 text-white font-semibold text-sm hover:bg-amber-700 transition-all duration-200 shadow-lg hover:shadow-xl"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          预约咨询服务
        </a>
      </div>
    </div>
  </section>
</OfficialLayout>
