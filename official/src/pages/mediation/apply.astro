---
import OfficialLayout from '../../layouts/OfficialLayout.astro'

const NEW_APPLY_URL = 'http://localhost:6080/party/apply'
---

<OfficialLayout title="调解申请" description="珠江国际商事调解院 - 在线提交调解申请材料">
  <!-- 兼容重定向：申请功能已迁移至调解工作台（6080） -->
  <meta http-equiv="refresh" content="0; url=http://localhost:6080/party/apply" />

  <!-- Hero -->
  <section class="relative py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/hero-bg.jpg');" />
    <div class="absolute inset-0 bg-gradient-to-br from-blue-950/85 via-blue-900/75 to-gray-900/85" />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-xs text-white/80 mb-4">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
        <span>在线申请</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">调解申请</h1>
      <p class="mt-3 text-base sm:text-lg text-blue-200 max-w-2xl mx-auto">正在跳转至调解工作台...</p>
    </div>
  </section>

  <!-- Fallback link -->
  <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">如果页面未自动跳转，请点击下方按钮：</p>
      <a href={NEW_APPLY_URL} target="_blank" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
        进入调解申请系统
      </a>
    </div>
  </section>
</OfficialLayout>
