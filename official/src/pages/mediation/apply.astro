---
import OfficialLayout from '../../layouts/OfficialLayout.astro'
---

<OfficialLayout title="调解申请" description="珠江国际商事调解院 - 在线提交调解申请材料">
  <!-- Hero -->
  <section class="relative py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/hero-bg.jpg');" />
    <div class="absolute inset-0 bg-gradient-to-br from-blue-950/85 via-blue-900/75 to-gray-900/85" />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-xs text-white/80 mb-4">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
        <span>在线申请</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">调解申请</h1>
      <p class="mt-3 text-base sm:text-lg text-blue-200 max-w-2xl mx-auto">提交调解申请书及相关材料，我院将在3个工作日内与您联系</p>
    </div>
  </section>

  <!-- Form -->
  <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900/50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Error banner -->
      <div id="error-banner" class="hidden mb-6 bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 rounded-lg p-4 text-sm text-red-700 dark:text-red-300">
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          <span id="error-text"></span>
        </div>
      </div>

      <form id="mediation-form" class="space-y-8">

        <!-- ═══ Section 1: 调解申请书 ═══ -->
        <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 flex items-center justify-center text-sm font-bold">1</span>
              <h3 class="text-base font-semibold text-gray-900 dark:text-white">调解申请书</h3>
            </div>
          </div>
          <div class="p-6 space-y-6">

            <!-- 智能识别（OCR 自动回填） -->
            <div class="rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50/50 dark:bg-blue-950/20 p-4">
              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h6"/><path d="M9 9h2"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">智能识别 · 自动回填</div>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">上传已填写的调解申请书（PDF / Word / 图片），系统将自动识别并回填下方表单字段，您可在此基础上修改。</p>
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <input type="file" id="ocr-input" accept=".pdf,.docx,.jpg,.jpeg,.png,.bmp,.webp,.tiff" class="hidden" />
                    <button type="button" id="ocr-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium transition">
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg>
                      <span id="ocr-btn-text">上传调解申请书识别</span>
                    </button>
                    <span id="ocr-status" class="text-xs text-gray-500 dark:text-gray-400"></span>
                  </div>
                  <div id="ocr-filename" class="hidden mt-2 text-xs text-gray-600 dark:text-gray-400 truncate"></div>
                </div>
              </div>
            </div>

            <!-- 申请人 -->
            <div>
              <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-1.5">
                <span class="w-1 h-4 bg-blue-600 rounded-full"></span>
                申请人信息
              </h4>
              <div class="grid sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">名称 / 姓名 <span class="text-red-500">*</span></label>
                  <input type="text" name="applicant_name" required class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="请输入申请人全称" />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">住所 / 地址</label>
                  <input type="text" name="applicant_address" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="详细通讯地址" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">邮政编码</label>
                  <input type="text" name="applicant_postal_code" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如 510000" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">固定电话</label>
                  <input type="text" name="applicant_phone" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如 020-83288530" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">移动电话</label>
                  <input type="text" name="applicant_mobile" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="手机号码" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">传真</label>
                  <input type="text" name="applicant_fax" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="传真号码" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">电子邮箱</label>
                  <input type="email" name="applicant_email" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="email@example.com" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">其他电子通讯方式</label>
                  <input type="text" name="applicant_other_contact" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如微信号、QQ号等" />
                </div>
              </div>
            </div>

            <!-- 被申请人 -->
            <div>
              <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-1.5">
                <span class="w-1 h-4 bg-amber-500 rounded-full"></span>
                被申请人信息
              </h4>
              <div class="grid sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">名称 / 姓名 <span class="text-red-500">*</span></label>
                  <input type="text" name="respondent_name" required class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="请输入被申请人全称" />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">住所 / 地址</label>
                  <input type="text" name="respondent_address" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="详细通讯地址" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">邮政编码</label>
                  <input type="text" name="respondent_postal_code" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如 510000" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">固定电话</label>
                  <input type="text" name="respondent_phone" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如 020-83288530" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">移动电话</label>
                  <input type="text" name="respondent_mobile" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="手机号码" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">传真</label>
                  <input type="text" name="respondent_fax" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="传真号码" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">电子邮箱</label>
                  <input type="email" name="respondent_email" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="email@example.com" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">其他电子通讯方式</label>
                  <input type="text" name="respondent_other_contact" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如微信号、QQ号等" />
                </div>
              </div>
            </div>

            <!-- 调解意愿 -->
            <div>
              <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-1.5">
                <span class="w-1 h-4 bg-green-500 rounded-full"></span>
                调解意愿 <span class="text-red-500">*</span>
              </h4>
              <div class="space-y-2">
                <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-900 transition has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-blue-950/30">
                  <input type="radio" name="mediation_willingness" value="mutual" required class="mt-0.5 w-4 h-4 text-blue-600 focus:ring-blue-500" />
                  <div>
                    <div class="text-sm font-medium text-gray-900 dark:text-white">各方当事人自愿接受调解</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">各方已达成一致，共同申请调解</div>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-900 transition has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-blue-950/30">
                  <input type="radio" name="mediation_willingness" value="single_party" required class="mt-0.5 w-4 h-4 text-blue-600 focus:ring-blue-500" />
                  <div>
                    <div class="text-sm font-medium text-gray-900 dark:text-white">当事人单方请求调解</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">由一方提出申请，我院将联系另一方征询意愿</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- 案件信息 -->
            <div>
              <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-1.5">
                <span class="w-1 h-4 bg-purple-500 rounded-full"></span>
                案件事实与诉求
              </h4>
              <div class="space-y-4">
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">案件事实</label>
                  <textarea name="case_facts" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition resize-y" placeholder="简要陈述案件发生的事实经过"></textarea>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">争议事项</label>
                  <textarea name="dispute_matters" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition resize-y" placeholder="说明各方争议的焦点"></textarea>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">调解诉求</label>
                  <textarea name="mediation_demands" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition resize-y" placeholder="明确希望通过调解实现的具体诉求"></textarea>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">理据</label>
                  <textarea name="demands_basis" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition resize-y" placeholder="支持诉求的法律依据、合同条款或事实理由"></textarea>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ═══ Section 2: 证据材料 ═══ -->
        <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 flex items-center justify-center text-sm font-bold">2</span>
              <h3 class="text-base font-semibold text-gray-900 dark:text-white">证据材料</h3>
            </div>
          </div>
          <div class="p-6 space-y-4">
            <p class="text-xs text-gray-500 dark:text-gray-400">上传合同、往来函件、票据、照片等相关证据材料及其他证明文件。支持 PDF、Word、图片、压缩包等格式，单文件最大 50MB。</p>

            <!-- Drop zone -->
            <div id="evidence-dropzone" class="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-lg p-6 text-center cursor-pointer hover:border-blue-500 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 transition">
              <input type="file" name="evidence_files" multiple class="hidden" id="evidence-input" accept=".pdf,.doc,.docx,.txt,.rtf,.odt,.jpg,.jpeg,.png,.gif,.bmp,.webp,.tiff,.zip,.rar,.7z,.xls,.xlsx,.csv,.md" />
              <svg class="w-10 h-10 mx-auto text-gray-400 dark:text-gray-600 mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg>
              <p class="text-sm text-gray-600 dark:text-gray-400">点击或拖拽文件到此处上传</p>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">可多选</p>
            </div>

            <!-- File list -->
            <div id="evidence-list" class="space-y-2"></div>

            <!-- Confidential checkbox -->
            <label class="flex items-start gap-3 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 cursor-pointer">
              <input type="checkbox" name="evidence_confidential" value="true" class="mt-0.5 w-4 h-4 text-amber-600 focus:ring-amber-500 rounded" />
              <div>
                <div class="text-sm font-medium text-amber-800 dark:text-amber-300">声明保密</div>
                <div class="text-xs text-amber-700 dark:text-amber-400 mt-0.5">声明该部分文件和证据材料仅供本院及调解员、专家查阅</div>
              </div>
            </label>
          </div>
        </div>

        <!-- ═══ Section 3: 身份证明文件 ═══ -->
        <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 flex items-center justify-center text-sm font-bold">3</span>
              <h3 class="text-base font-semibold text-gray-900 dark:text-white">身份证明文件</h3>
            </div>
          </div>
          <div class="p-6 space-y-4">
            <p class="text-xs text-gray-500 dark:text-gray-400">上传身份证、营业执照、组织机构代码证等身份证明文件。</p>

            <!-- Identity drop zone -->
            <div id="identity-dropzone" class="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-lg p-6 text-center cursor-pointer hover:border-blue-500 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 transition">
              <input type="file" name="identity_files" multiple class="hidden" id="identity-input" accept=".pdf,.doc,.docx,.txt,.rtf,.odt,.jpg,.jpeg,.png,.gif,.bmp,.webp,.tiff,.zip,.rar,.7z,.xls,.xlsx,.csv,.md" />
              <svg class="w-10 h-10 mx-auto text-gray-400 dark:text-gray-600 mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
              <p class="text-sm text-gray-600 dark:text-gray-400">点击或拖拽文件到此处上传</p>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">可多选</p>
            </div>
            <div id="identity-list" class="space-y-2"></div>

            <!-- Agent toggle -->
            <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-900 transition has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-blue-950/30">
              <input type="checkbox" name="has_agent" value="true" id="has-agent-checkbox" class="w-4 h-4 text-blue-600 focus:ring-blue-500 rounded" />
              <div>
                <div class="text-sm font-medium text-gray-900 dark:text-white">委托代理人或代表参与调解</div>
                <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">如委托代理人，须提交授权委托书</div>
              </div>
            </label>

            <!-- Agent details (conditional) -->
            <div id="agent-section" class="hidden space-y-4 pl-4 border-l-2 border-blue-200 dark:border-blue-800">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">代理人姓名</label>
                  <input type="text" name="agent_name" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="代理人或代表姓名" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">代理人职责</label>
                  <input type="text" name="agent_duties" class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" placeholder="如：一般授权 / 特别授权" />
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">授权委托书</label>
                <div id="auth-dropzone" class="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-lg p-4 text-center cursor-pointer hover:border-blue-500 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 transition">
                  <input type="file" name="authorization_files" multiple class="hidden" id="auth-input" accept=".pdf,.doc,.docx,.txt,.rtf,.odt,.jpg,.jpeg,.png,.gif,.bmp,.webp,.tiff,.zip,.rar,.7z,.xls,.xlsx,.csv,.md" />
                  <svg class="w-8 h-8 mx-auto text-gray-400 dark:text-gray-600 mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                  <p class="text-sm text-gray-600 dark:text-gray-400">上传授权委托书</p>
                </div>
                <div id="auth-list" class="space-y-2 mt-2"></div>
              </div>
            </div>

          </div>
        </div>

        <!-- Submit -->
        <div class="flex flex-col sm:flex-row gap-3 items-center justify-end">
          <a href="/mediation" class="px-6 py-3 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition">取消</a>
          <button type="submit" id="submit-btn" class="w-full sm:w-auto px-8 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
            <svg id="submit-icon" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            <svg id="submit-spinner" class="hidden w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
            <span id="submit-text">提交申请</span>
          </button>
        </div>

      </form>

    </div>
  </section>

  <!-- ── 提交成功弹窗 ── -->
  <div id="success-modal" class="fixed inset-0 z-50 flex items-center justify-center opacity-0 scale-95 pointer-events-none transition-all duration-200" role="dialog" aria-modal="true" aria-hidden="true">
    <div id="success-overlay" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="relative bg-white dark:bg-gray-950 border border-green-200 dark:border-green-800 rounded-2xl shadow-2xl p-8 max-w-sm w-[calc(100vw-2rem)] text-center">
      <div class="w-16 h-16 mx-auto rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-green-600 dark:text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1">申请提交成功</h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-5">请妥善保管以下信息，查询案件进度时需要使用。</p>

      <div class="space-y-3 mb-6">
        <div class="flex items-center justify-between px-4 py-3 rounded-lg bg-gray-100 dark:bg-gray-900 text-sm">
          <span class="text-gray-500 dark:text-gray-400">案件编号</span>
          <span id="success-case-number" class="font-mono font-bold text-blue-600 dark:text-blue-400"></span>
        </div>
        <div class="flex items-center justify-between px-4 py-3 rounded-lg bg-gray-100 dark:bg-gray-900 text-sm">
          <span class="text-gray-500 dark:text-gray-400">初始密码</span>
          <span id="success-password" class="font-mono font-bold text-amber-600 dark:text-amber-400"></span>
        </div>
      </div>

      <p class="text-xs text-gray-400 dark:text-gray-500 mb-5">我院将在3个工作日内与您联系，请保持通讯畅通。</p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/mediation" class="px-6 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition">返回首页</a>
        <button type="button" id="new-application-btn" class="px-6 py-2.5 rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium text-sm hover:bg-gray-50 dark:hover:bg-gray-900 transition">再提交一份</button>
      </div>
    </div>
  </div>

</OfficialLayout>

<script is:inline>
  const API_URL = 'http://localhost:6080/api/cases/create';
  const OCR_URL = 'http://localhost:6080/api/ocr';

  // ── OCR autofill ──
  const ocrInput = document.getElementById('ocr-input');
  const ocrBtn = document.getElementById('ocr-btn');
  const ocrBtnText = document.getElementById('ocr-btn-text');
  const ocrStatus = document.getElementById('ocr-status');
  const ocrFilename = document.getElementById('ocr-filename');

  // Field labels for status reporting
  const FIELD_LABELS = {
    applicant_name: '申请人名称', applicant_address: '申请人地址', applicant_postal_code: '申请人邮编',
    applicant_phone: '申请人固话', applicant_mobile: '申请人手机', applicant_fax: '申请人传真',
    applicant_email: '申请人邮箱', applicant_other_contact: '申请人其他联系方式',
    respondent_name: '被申请人名称', respondent_address: '被申请人地址', respondent_postal_code: '被申请人邮编',
    respondent_phone: '被申请人固话', respondent_mobile: '被申请人手机', respondent_fax: '被申请人传真',
    respondent_email: '被申请人邮箱', respondent_other_contact: '被申请人其他联系方式',
    mediation_willingness: '调解意愿',
    case_facts: '案件事实', dispute_matters: '争议事项', mediation_demands: '调解诉求', demands_basis: '理据',
    agent_name: '代理人姓名', agent_duties: '代理人职责',
  };

  ocrBtn.addEventListener('click', () => ocrInput.click());

  ocrInput.addEventListener('change', async () => {
    const file = ocrInput.files[0];
    if (!file) return;

    // Show filename
    ocrFilename.textContent = `已选择: ${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
    ocrFilename.classList.remove('hidden');

    // Loading state
    ocrBtn.disabled = true;
    ocrBtnText.textContent = '识别中...';
    ocrStatus.textContent = '正在提取文本并识别字段，请稍候...';
    ocrStatus.className = 'text-xs text-blue-600 dark:text-blue-400';

    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch(OCR_URL, { method: 'POST', body: formData });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || data.detail || '识别失败');
      }

      const fields = data.fields || {};
      let filled = 0;
      const filledNames = [];

      Object.keys(FIELD_LABELS).forEach(key => {
        const val = fields[key];
        if (!val) return;

        // mediation_willingness is a radio
        if (key === 'mediation_willingness') {
          const radio = document.querySelector(`input[name="${key}"][value="${val}"]`);
          if (radio) {
            radio.checked = true;
            filled++;
            filledNames.push(FIELD_LABELS[key]);
          }
          return;
        }

        // agent fields — only fill if agent section visible or has value
        if (key.startsWith('agent_')) {
          const agentCheckbox = document.getElementById('has-agent-checkbox');
          if (agentCheckbox && !agentCheckbox.checked) {
            agentCheckbox.checked = true;
            document.getElementById('agent-section').classList.remove('hidden');
          }
        }

        const input = document.querySelector(`[name="${key}"]`);
        if (input) {
          input.value = val;
          // brief highlight
          input.classList.add('ring-2', 'ring-green-400', 'bg-green-50/50');
          setTimeout(() => input.classList.remove('ring-2', 'ring-green-400', 'bg-green-50/50'), 2000);
          filled++;
          filledNames.push(FIELD_LABELS[key]);
        }
      });

      const methodLabel = data.used_ocr ? 'OCR识别' : '文本提取';
      ocrStatus.textContent = `✓ ${methodLabel}完成，已回填 ${filled} 个字段${filledNames.length ? '：' + filledNames.slice(0, 4).join('、') + (filledNames.length > 4 ? '等' : '') : ''}`;
      ocrStatus.className = 'text-xs text-green-600 dark:text-green-400';
    } catch (err) {
      ocrStatus.textContent = `✗ ${err.message || '识别失败'}`;
      ocrStatus.className = 'text-xs text-red-600 dark:text-red-400';
    } finally {
      ocrBtn.disabled = false;
      ocrBtnText.textContent = '上传调解申请书识别';
      ocrInput.value = ''; // allow re-upload same file
    }
  });

  // ── File upload helpers ──
  function setupDropzone(dropzoneId, inputId, listId) {
    const dropzone = document.getElementById(dropzoneId);
    const input = document.getElementById(inputId);
    const list = document.getElementById(listId);

    dropzone.addEventListener('click', () => input.click());

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-blue-500', 'bg-blue-50/50');
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-blue-500', 'bg-blue-50/50');
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-blue-500', 'bg-blue-50/50');
      input.files = e.dataTransfer.files;
      renderFileList(input, list);
    });

    input.addEventListener('change', () => renderFileList(input, list));
  }

  function renderFileList(input, list) {
    list.innerHTML = '';
    Array.from(input.files).forEach((file, i) => {
      const size = file.size > 1024 * 1024
        ? (file.size / 1024 / 1024).toFixed(1) + ' MB'
        : (file.size / 1024).toFixed(0) + ' KB';
      const item = document.createElement('div');
      item.className = 'flex items-center gap-2 px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-sm';
      item.innerHTML = `
        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        <span class="flex-1 truncate text-gray-700 dark:text-gray-300">${escapeHtml(file.name)}</span>
        <span class="text-xs text-gray-400">${size}</span>
      `;
      list.appendChild(item);
    });
  }

  function escapeHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  setupDropzone('evidence-dropzone', 'evidence-input', 'evidence-list');
  setupDropzone('identity-dropzone', 'identity-input', 'identity-list');
  setupDropzone('auth-dropzone', 'auth-input', 'auth-list');

  // ── Agent toggle ──
  const agentCheckbox = document.getElementById('has-agent-checkbox');
  const agentSection = document.getElementById('agent-section');
  agentCheckbox.addEventListener('change', () => {
    agentSection.classList.toggle('hidden', !agentCheckbox.checked);
  });

  // ── Form submit ──
  const form = document.getElementById('mediation-form');
  const submitBtn = document.getElementById('submit-btn');
  const submitIcon = document.getElementById('submit-icon');
  const submitSpinner = document.getElementById('submit-spinner');
  const submitText = document.getElementById('submit-text');
  const errorBanner = document.getElementById('error-banner');
  const errorText = document.getElementById('error-text');

  // ── Success modal ──
  const successModal = document.getElementById('success-modal');
  const successOverlay = document.getElementById('success-overlay');
  const successCaseNumber = document.getElementById('success-case-number');
  const successPassword = document.getElementById('success-password');
  const newAppBtn = document.getElementById('new-application-btn');

  function showModal() {
    successModal.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
    successModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    successModal.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    successModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function showError(msg) {
    errorText.textContent = msg;
    errorBanner.classList.remove('hidden');
    errorBanner.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function hideError() {
    errorBanner.classList.add('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    // Basic validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    submitIcon.classList.add('hidden');
    submitSpinner.classList.remove('hidden');
    submitText.textContent = '提交中...';

    try {
      const formData = new FormData(form);
      // workbench create API 需要案件类型
      formData.append('caseType', 'mediation');
      const res = await fetch(API_URL, { method: 'POST', body: formData });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.detail || data.message || '提交失败，请稍后重试');
      }

      // workbench 响应结构 {success, data:{caseNumber, accessCode, ...}}
      const result = data.data || data;
      // Show modal with case number & password
      successCaseNumber.textContent = result.caseNumber || result.case_number || result.id;
      successPassword.textContent = result.accessCode || result.password || '123';
      showModal();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      showError(err.message || '网络错误，请检查网络连接后重试');
    } finally {
      submitBtn.disabled = false;
      submitIcon.classList.remove('hidden');
      submitSpinner.classList.add('hidden');
      submitText.textContent = '提交申请';
    }
  });

  // ── New application ──
  document.getElementById('new-application-btn').addEventListener('click', () => {
    form.reset();
    document.getElementById('evidence-list').innerHTML = '';
    document.getElementById('identity-list').innerHTML = '';
    document.getElementById('auth-list').innerHTML = '';
    agentSection.classList.add('hidden');
    closeModal();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── Close modal on overlay click ──
  successOverlay.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && successModal.getAttribute('aria-hidden') === 'false') closeModal();
  });
</script>