---
import OfficialLayout from '../../layouts/OfficialLayout.astro'
---

<OfficialLayout title="调解服务" description="珠江国际商事调解院 - 案件管理">
  <!-- Hero -->
  <section class="relative py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/hero-bg.jpg');" />
    <div class="absolute inset-0 bg-gradient-to-br from-blue-950/85 via-blue-900/75 to-gray-900/85" />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-xs text-white/80 mb-4">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 19.5v.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8.5L18 5.5"/><circle cx="8" cy="13" r="2"/><path d="M14 19c0-3.5 3-5 5-5"/><path d="M14 13c0-2.5 2-4 4-4"/></svg>
        <span>调解服务</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">调解服务</h1>
      <p class="mt-3 text-base sm:text-lg text-blue-200 max-w-2xl mx-auto">查询已有案件进度，或提交新的调解申请</p>
    </div>
  </section>

  <!-- Options -->
  <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6 md:gap-8">

        <!-- Card 1: 已有案件 -->
        <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden">
          <div class="p-6 sm:p-8">
            <div class="w-12 h-12 rounded-lg bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-1">已有案件</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-5">输入案号查询案件进度，并可使用智能咨询分析案情</p>

            <!-- Query form -->
            <div id="case-query" class="space-y-3">
              <div>
                <label for="case-number-input" class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">案号</label>
                <div class="flex gap-2">
                  <input type="text" id="case-number-input" placeholder="如 2026-1" class="flex-1 px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-amber-500 focus:border-transparent outline-none transition" />
                  <input type="password" id="case-access-code" placeholder="访问验证码" class="w-40 px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-amber-500 focus:border-transparent outline-none transition" />
                  <button type="button" id="query-btn" class="px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium transition flex items-center gap-1.5">
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <span id="query-btn-text">查询</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Query result -->
            <div id="query-result" class="hidden mt-4 space-y-3"></div>

            <!-- Loading / Error states -->
            <div id="query-status" class="mt-3 text-sm"></div>
          </div>
        </div>

        <!-- Card 2: 新建案件 -->
        <a href="/mediation/apply" class="group bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="p-6 sm:p-8">
            <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 9v6"/><path d="M9 12h6"/></svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-1">新建案件</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-5">在线提交调解申请书及相关材料，启动调解程序</p>
            <div class="flex items-center gap-1 text-sm font-medium text-blue-600 dark:text-blue-400">
              <span>开始申请</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>
</OfficialLayout>

<script is:inline>
  const CASE_API_URL = 'http://localhost:6080/api/public/cases';
  const CASE_VERIFY_URL = 'http://localhost:6080/api/public/case-context';
  const caseInput = document.getElementById('case-number-input');
  const accessInput = document.getElementById('case-access-code');
  const queryBtn = document.getElementById('query-btn');
  const queryBtnText = document.getElementById('query-btn-text');
  const queryResult = document.getElementById('query-result');
  const queryStatus = document.getElementById('query-status');

  async function queryCase() {
    const caseNumber = caseInput.value.trim();
    const accessCode = accessInput.value.trim();
    if (!caseNumber) {
      queryStatus.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
      queryStatus.textContent = '请输入案号';
      return;
    }
    if (!accessCode) {
      queryStatus.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
      queryStatus.textContent = '请输入访问验证码以查看案件详情';
      return;
    }

    // Loading
    queryBtn.disabled = true;
    queryBtnText.textContent = '查询中...';
    queryResult.classList.add('hidden');
    queryStatus.className = 'mt-3 text-sm text-blue-600 dark:text-blue-400';
    queryStatus.textContent = '正在验证访问码...';

    try {
      // 先验证访问码并获取受限的案情摘要
      const verifyResp = await fetch(CASE_VERIFY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ caseNumber: caseNumber, accessCode: accessCode }),
      });
      if (!verifyResp.ok) {
        const err = await verifyResp.json().catch(() => ({ detail: '验证失败' }));
        throw new Error(err.detail || '访问码验证失败');
      }
      const v = await verifyResp.json();
      if (!v?.success) throw new Error('访问码验证失败');

      queryStatus.className = 'mt-3 text-sm text-blue-600 dark:text-blue-400';
      queryStatus.textContent = '正在查询案件信息...';

      // 验证通过后获取公开案件信息（仍为精简字段）
      const res = await fetch(`${CASE_API_URL}/${encodeURIComponent(caseNumber)}`);
      if (!res.ok) {
        const err = await res.json().catch(() => ({ detail: '查询失败' }));
        throw new Error(err.detail || `案号 ${caseNumber} 未找到`);
      }
      const data = await res.json();

      // attach summary from verification
      data.summary = v.summary || '';


      // Build result card
      const statusMap = {
        submitted: '已提交',
        processing: '处理中',
        completed: '已完成',
        closed: '已结案',
      };
      const willingnessMap = {
        mutual: '各方自愿接受调解',
        single_party: '单方请求调解',
      };

      queryResult.innerHTML = `
        <div class="rounded-lg border border-green-200 dark:border-green-800 bg-green-50/50 dark:bg-green-950/20 p-4 space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-gray-900 dark:text-white">案件信息</h3>
            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">${escapeHtml(caseNumber)}</span>
          </div>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <div><span class="text-gray-500 dark:text-gray-400">申请人：</span><span class="text-gray-900 dark:text-white font-medium">${escapeHtml(data.applicant_name || '—')}</span></div>
            <div><span class="text-gray-500 dark:text-gray-400">被申请人：</span><span class="text-gray-900 dark:text-white font-medium">${escapeHtml(data.respondent_name || '—')}</span></div>
            <div><span class="text-gray-500 dark:text-gray-400">调解意愿：</span><span class="text-gray-900 dark:text-white">${escapeHtml(willingnessMap[data.mediation_willingness] || data.mediation_willingness || '—')}</span></div>
            <div><span class="text-gray-500 dark:text-gray-400">状态：</span><span class="text-gray-900 dark:text-white">${escapeHtml(statusMap[data.status] || data.status || '—')}</span></div>
            <div class="col-span-2"><span class="text-gray-500 dark:text-gray-400">提交时间：</span><span class="text-gray-900 dark:text-white">${escapeHtml(data.created_at ? new Date(data.created_at).toLocaleString('zh-CN') : '—')}</span></div>
          </div>
          <div class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-line mt-2 p-2 rounded bg-white/50 dark:bg-gray-900/40 border border-gray-100 dark:border-gray-800">${escapeHtml(data.summary || data.title || '')}</div>
          <button type="button" id="ai-analyze-btn" class="w-full mt-1 px-4 py-2.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium transition flex items-center justify-center gap-2">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4Z"/><path d="M20 12v4a8 8 0 0 1-16 0v-4"/><path d="M12 18v4"/></svg>
            进入智能咨询分析案件
          </button>
        </div>
      `;
      queryResult.classList.remove('hidden');
      queryStatus.className = 'mt-3 text-sm text-green-600 dark:text-green-400';
      queryStatus.textContent = '';

      // Wire up the AI analyze button — open chat and pass caseNumber + accessCode as detail
      document.getElementById('ai-analyze-btn').addEventListener('click', () => {
        const evt = new CustomEvent('ai-chat:open', { detail: { caseNumber: caseNumber, accessCode: accessCode } });
        document.dispatchEvent(evt);
        // also scroll to top to ensure chat FAB is visible
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

    } catch (err) {
      queryResult.classList.add('hidden');
      queryStatus.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
      queryStatus.textContent = err.message || '查询失败，请稍后重试';
    } finally {
      queryBtn.disabled = false;
      queryBtnText.textContent = '查询';
    }
  }

  function escapeHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  // Event listeners
  queryBtn.addEventListener('click', queryCase);
  caseInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') queryCase();
  });
</script>