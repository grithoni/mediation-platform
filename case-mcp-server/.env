# 案件 MCP 服务配置

# 案件数据库 — 指向 mediation-apply 的 SQLite
CASE_DB_URL=sqlite:////Users/honi/Desktop/projects/mediation-platform/mediation-apply/data/mediation.db
CASE_DB_TABLE=applications
CASE_DB_ID_FIELD=id
# 文本字段：案件事实/争议事项/调解诉求/理据
CASE_DB_TEXT_FIELDS=case_facts,dispute_matters,mediation_demands,demands_basis
# 当事人字段：申请人 + 被申请人（多字段合并）
CASE_DB_PARTIES_FIELDS=applicant_name,respondent_name
# 地址字段：申请人地址 + 被申请人地址（多字段合并）
CASE_DB_ADDRESSES_FIELDS=applicant_address,respondent_address

# 映射表存储
MAPPING_DB_PATH=data/mapping.db
MAPPING_KEY_FILE=data/.master_key
MAPPING_TTL_SECONDS=7200

# 本地 NER 模型（可选，不配置则仅用正则+精确匹配）
NER_BASE_URL=http://localhost:11434
NER_MODEL=
NER_API_KEY=

# 报告输出目录
REPORT_DIR=reports